{
  "name": "veriastra",
  "version": "0.2.0",
  "description": "Typed, zero-dependency client for the Veriastra data-validation API. Methods match the live OpenAPI 3.1 document (40 paths).",
  "keywords": ["email-verification", "phone-validation", "ip-intelligence", "sanctions-screening", "fraud-detection", "kyc", "data-validation"],
  "homepage": "https://veriastra.com/docs",
  "repository": { "type": "git", "url": "git+https://github.com/grnbtqdbyx-create/veriastra-sdk.git" },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
